# MongoDB Atlas connection string (same as backend)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Admin panel login credentials
ADMIN_EMAIL=admin@furniro.com
ADMIN_PASSWORD=your_secure_admin_password

# Admin panel port
ADMIN_PORT=3002

# Cookie secret — use a strong random string (32+ characters)
COOKIE_SECRET=change-this-to-a-very-long-random-string-at-least-32-chars

# Session secret — use a strong random string (32+ characters)
SESSION_SECRET=change-this-to-another-long-random-string-at-least-32-chars

# Node Environment
NODE_ENV=production
