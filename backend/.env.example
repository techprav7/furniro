# MongoDB Atlas connection string
# Get yours at: https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secret — use a strong random string (64+ characters)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server port
PORT=3001

# Frontend URL (for CORS whitelist)
# Development: http://localhost:5173
# Production: https://www.praver.space
FRONTEND_URL=http://localhost:5173

# Node environment
NODE_ENV=development

# Resend Email Integration
# Register on resend.com to obtain your API key.
RESEND_API_KEY=re_your_api_key_here
# The sender address. Using onboarding@resend.dev lets you send to your registered account email.
# To send to arbitrary user emails, verify a custom domain in your Resend dashboard (resend.com/domains).
RESEND_FROM_EMAIL="Furniro <orders@praver.space>"
# Support email shown in the footer of order confirmations.
SUPPORT_EMAIL=tech.prav7@gmail.com